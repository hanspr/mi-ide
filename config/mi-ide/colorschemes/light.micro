color-link default "#000000,#FFFFFF"
color-link comment "italic #222222,#CCCCCC"
color-link type.keyword "bold #a34765"
color-link type.other "bold #ff0055"
color-link identifier "#000000"
color-link identifier.var "#000000"
color-link constant "#5f0ba3"
color-link constant.number "bold #d87a0e"
color-link constant.string "#2a612a"
color-link constant.var "#C1FFC1"
color-link constant.string.char "#dbc500"
color-link constant.string.url "italic #17a317"
color-link statement "#FF005F"
color-link symbol "#F92672"
color-link symbol.operator "bold #F92672"
color-link symbol.brackets "#3469fc"
color-link symbol.tag "#1f49dc"
color-link preproc "#991c88"
color-link type "#0162d8"
color-link function "bold #0043a1"
color-link method "#520a4c"
color-link method.other "#8f0d85"
color-link special "#8aaa49"
color-link underlined "underline"
color-link label "bold underline #ffffff"
color-link info "bold #1f49dc,#CCCCCC"
color-link error "bold #FF0000,#CCCCCC"
color-link todo "bold #fb7900,#CCCCCC"
color-link statusline "#ffffff,#005FAF"
color-link unfocused "#888888,#333333"
color-link tabbar "#ffffff,#005FAF"
color-link invisible-char ",#444444"
color-link line-number "#DADADA,#303030"
color-link current-line-number "bold gold,#000000"
color-link gutter-error "#CB4B16"
color-link gutter-warning "#E6DB74"
color-link cursor-line "#CCCCCC"
color-link color-column "#323232"
color-link selection "black,lightcyan"
color-link matchbrace "bold lightskyblue,#0000FF"
color-link md-head "bold #A6E22E"
color-link md-bold "bold lightskyblue"
color-link md-table "#ffdab9"
color-link md-url "#FFED00"
color-link md-italic "italic #AAAAFF"
color-link invisible "#000000"
